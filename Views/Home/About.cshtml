@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<SunmedMedikal.Models.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = SharedLocalizer["Kurumsal / Hakkımızda"];
}

<style>
    body { background-color: #050505 !important; }
    
    .about-card {
        background-color: #0a0a0a;
        border: 1px solid #1a1a1a;
        border-radius: 12px;
        transition: transform 0.3s ease;
    }
    .about-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(220, 53, 69, 0.1);
    }
    
    .icon-box {
        width: 60px; height: 60px; background-color: #121212; border: 1px solid #dc3545;
        border-radius: 50%; display: flex; align-items: center; justify-content: center;
        font-size: 1.5rem; color: #dc3545; margin-bottom: 20px;
    }

    .about-banner {
        background: linear-gradient(rgba(5, 5, 5, 0.8), rgba(5, 5, 5, 0.8)), url('https://images.unsplash.com/photo-1579154392061-07314781498b?q=80&w=2070&auto=format&fit=crop') center/cover;
        border-bottom: 3px solid #dc3545;
        padding: 100px 0; 
    }
</style>

<div class="container-fluid about-banner">
    <div class="container">
        <div class="row text-center">
            <div class="col-12">
                <h1 class="display-4 fw-bold text-uppercase" style="color: #ffffff; letter-spacing: 2px;">
                    @SharedLocalizer["BİZ"] <span class="text-danger">@SharedLocalizer["KİMİZ?"]</span>
                </h1>
                <div style="width: 80px; height: 4px; background-color: #dc3545; margin: 20px auto;"></div>
                <p class="fs-5 mt-4 text-white-50 mx-auto" style="max-width: 700px;">
                    @SharedLocalizer["Laboratuvarınızın kalbinde yatan gücüz. Bilimin ve sağlığın ilerlemesi için global markaları en güvenilir ve hızlı şekilde kapınıza getiriyoruz."]
                </p>
            </div>
        </div>
    </div>
</div>

<div class="container mt-5 mb-5 pb-5">
    <div class="row align-items-center mb-5 pb-4 border-bottom border-secondary">
        <div class="col-lg-6 mb-4 mb-lg-0">
            <div class="p-2 rounded-3 shadow-lg" style="background-color: #121212; border: 1px solid #333;">
                
                <img src="https://images.unsplash.com/photo-1532094349884-543bc11b234d?q=80&w=1000&auto=format&fit=crop" alt="SUNMED Medikal Laboratuvar" class="img-fluid rounded" style="width: 100%; height: 350px; object-fit: cover; opacity: 0.9;">
                
            </div>
        </div>
        <div class="col-lg-6 ps-lg-5">
            <h3 class="fw-bold text-white mb-4">SUNMED <span class="text-danger">Medikal</span> & Global Laboratuvar Marketi</h3>
            <p class="text-white-50" style="line-height: 1.8;">
                @SharedLocalizer["Sektördeki tecrübemiz ve dinamik yapımızla, medikal ve laboratuvar sarf malzemeleri, kimyasallar ve cihazlar alanında Türkiye'nin öncü tedarikçilerinden biri olma vizyonuyla yola çıktık."]
            </p>
            <p class="text-white-50" style="line-height: 1.8;">
                @SharedLocalizer["Amacımız sadece ürün satmak değil; üniversiteler, araştırma merkezleri, hastaneler ve endüstriyel laboratuvarlar için güvenilir bir çözüm ortağı olmaktır. Merck, Isolab, 3M gibi dünyanın en prestijli markalarını tek bir çatı altında toplayarak satın alma süreçlerinizi profesyonelleştiriyoruz."]
            </p>
            <div class="d-flex align-items-center mt-4 pt-2">
                <div class="me-4 border-end border-secondary pe-4">
                    <h2 class="text-danger fw-bold mb-0">100%</h2>
                    <span class="text-muted small text-uppercase">@SharedLocalizer["Orijinal Ürün"]</span>
                </div>
                <div>
                    <h2 class="text-danger fw-bold mb-0">7/24</h2>
                    <span class="text-muted small text-uppercase">@SharedLocalizer["Kesintisiz Destek"]</span>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card about-card h-100 p-4 text-center">
                <div class="d-flex justify-content-center"><div class="icon-box">👁️</div></div>
                <h5 class="text-white fw-bold mb-3">@SharedLocalizer["Vizyonumuz"]</h5>
                <p class="text-white-50 small">@SharedLocalizer["Global standartlardaki laboratuvar teknolojilerini ve sarf malzemelerini en erişilebilir şekilde sunarak, bilimsel araştırmaların ve sağlık hizmetlerinin kalitesini artıran lider tedarikçi olmak."]</p>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card about-card h-100 p-4 text-center" style="border-top: 3px solid #dc3545;">
                <div class="d-flex justify-content-center"><div class="icon-box" style="background-color: #dc3545; color: #fff;">🎯</div></div>
                <h5 class="text-white fw-bold mb-3">@SharedLocalizer["Misyonumuz"]</h5>
                <p class="text-white-50 small">@SharedLocalizer["Müşterilerimizin ihtiyaçlarını doğru analiz edip, en kaliteli ürünleri, en optimum fiyatlar ve en hızlı teslimat süreçleriyle sunarak koşulsuz müşteri memnuniyeti sağlamak."]</p>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card about-card h-100 p-4 text-center">
                <div class="d-flex justify-content-center"><div class="icon-box">💎</div></div>
                <h5 class="text-white fw-bold mb-3">@SharedLocalizer["Değerlerimiz"]</h5>
                <p class="text-white-50 small">@SharedLocalizer["Dürüstlük, şeffaflık, kalite odaklılık ve yenilikçilik. İş ortaklarımızla kurduğumuz uzun vadeli güven ilişkisi, şirket kültürümüzün temel taşıdır."]</p>
            </div>
        </div>
    </div>
</div>