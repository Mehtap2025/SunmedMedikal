@model IEnumerable<SunmedMedikal.Models.SubSubCategory>
@{
    ViewData["Title"] = "3. Alt Kategorileri Yönet";
}

<div class="container mt-4">
    <div class="card bg-dark text-white border-secondary mb-4 shadow">
        <div class="card-header border-secondary d-flex justify-content-between align-items-center">
            <h4 class="mb-0 text-danger fw-bold">🛠️ Yeni 3. Seviye Alt Kategori Ekle</h4>
        </div>
        <div class="card-body">
            <form asp-action="AddSubSubCategory" method="post" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label text-white-50">Ana Kategori</label>
                    <select name="MainCategory" id="MainCatSelect" class="form-select bg-dark text-white border-secondary" required>
                        <option value="">Seçiniz</option>
                        @foreach(var main in ViewBag.MainCategories) {
                            <option value="@main.Name">@main.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label text-white-50">Alt Kategori</label>
                    <select name="SubCategory" id="SubCatSelect" class="form-select bg-dark text-white border-secondary" required>
                        <option value="">Seçiniz</option>
                        @foreach(var sub in ViewBag.SubCategories) {
                            <option value="@sub.Name" data-main="@sub.MainCategory">@sub.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label text-white-50">Yeni 3. Kategori Adı</label>
                    <input type="text" name="Name" class="form-control bg-dark text-white border-secondary" placeholder="Örn: Plastik Beherler" required>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-danger w-100 fw-bold">Ekle</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card bg-dark text-white border-secondary shadow">
        <div class="card-header border-secondary">
            <h4 class="mb-0 fw-bold">Mevcut 3. Alt Kategoriler</h4>
        </div>
        <div class="card-body p-0">
            <table class="table table-dark table-striped table-hover mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Ana Kategori</th>
                        <th>Alt Kategori</th>
                        <th class="text-danger">3. Kategori Adı</th>
                        <th class="text-end pe-4">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 align-middle text-muted">@item.Id</td>
                            <td class="align-middle">@item.MainCategory</td>
                            <td class="align-middle">@item.SubCategory</td>
                            <td class="align-middle fw-bold text-white">@item.Name</td>
                            <td class="text-end pe-4 align-middle">
                                <a href="/Admin/EditSubSubCategory/@item.Id" class="btn btn-sm btn-outline-info me-2">Düzenle</a>
                                <a href="/Admin/DeleteSubSubCategory/@item.Id" class="btn btn-sm btn-outline-danger" onclick="return confirm('@item.Name silinsin mi? (Buna bağlı ürünler etkilenir!)');">Sil</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('MainCatSelect').addEventListener('change', function() {
            var selectedMain = this.value;
            var subOptions = document.getElementById('SubCatSelect').querySelectorAll('option[data-main]');
            subOptions.forEach(opt => {
                opt.style.display = opt.getAttribute('data-main') === selectedMain ? 'block' : 'none';
            });
            document.getElementById('SubCatSelect').value = "";
        });
    </script>
}