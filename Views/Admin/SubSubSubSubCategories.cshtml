@model IEnumerable<SunmedMedikal.Models.SubSubSubSubCategory>
@{
    ViewData["Title"] = "5. Alt Kategorileri Yönet";
}

<div class="container-fluid mt-4">
    
    <div class="card border-dark shadow-sm bg-dark text-white mb-4">
        <div class="card-header border-bottom border-secondary p-3">
            <h5 class="mb-0 fw-bold text-danger">🛠️ Yeni 5. Seviye Alt Kategori Ekle</h5>
        </div>
        <div class="card-body p-4">
            <form asp-action="AddSubSubSubSubCategory" method="post">
                <div class="row align-items-end">
                    <div class="col-md-2 mb-3">
                        <label class="form-label small text-white-50">Ana Kategori</label>
                        <select name="MainCategory" id="MainCategorySelect" class="form-select bg-dark text-white border-secondary" required>
                            <option value="">Seçiniz</option>
                            @if(ViewBag.MainCategories != null) {
                                foreach(var main in ViewBag.MainCategories) { <option value="@main.Name">@main.Name</option> }
                            }
                        </select>
                    </div>
                    
                    <div class="col-md-2 mb-3">
                        <label class="form-label small text-white-50">Alt Kategori</label>
                        <select name="SubCategory" id="SubCategorySelect" class="form-select bg-dark text-white border-secondary" required>
                            <option value="">Seçiniz</option>
                            @if(ViewBag.SubCategories != null) {
                                foreach(var sub in ViewBag.SubCategories) { <option value="@sub.Name" data-main="@sub.MainCategory">@sub.Name</option> }
                            }
                        </select>
                    </div>

                    <div class="col-md-2 mb-3">
                        <label class="form-label small text-white-50">3. Kategori</label>
                        <select name="SubSubCategory" id="SubSubCategorySelect" class="form-select bg-dark text-white border-secondary" required>
                            <option value="">Seçiniz</option>
                            @if(ViewBag.SubSubCategories != null) {
                                foreach(var ss in ViewBag.SubSubCategories) { <option value="@ss.Name" data-sub="@ss.SubCategory">@ss.Name</option> }
                            }
                        </select>
                    </div>

                    <div class="col-md-2 mb-3">
                        <label class="form-label small text-white-50">4. Kategori</label>
                        <select name="SubSubSubCategory" id="SubSubSubCategorySelect" class="form-select bg-dark text-white border-secondary" required>
                            <option value="">Seçiniz</option>
                            @if(ViewBag.SubSubSubCategories != null) {
                                foreach(var sss in ViewBag.SubSubSubCategories) { <option value="@sss.Name" data-subsub="@sss.SubSubCategory">@sss.Name</option> }
                            }
                        </select>
                    </div>

                    <div class="col-md-3 mb-3">
                        <label class="form-label small text-white-50">Yeni 5. Kategori Adı</label>
                        <input type="text" name="Name" class="form-control bg-dark text-white border-secondary" required />
                    </div>

                    <div class="col-md-1 mb-3">
                        <button type="submit" class="btn btn-danger w-100 fw-bold">Ekle</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-dark shadow-sm bg-dark text-white">
        <div class="card-header border-bottom border-secondary p-3">
            <h5 class="mb-0 fw-bold">Mevcut 5. Alt Kategoriler</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0 align-middle">
                    <thead>
                        <tr class="border-secondary">
                            <th class="px-4 py-3">ID</th>
                            <th class="px-4 py-3">Ana Kategori</th>
                            <th class="px-4 py-3">Alt Kategori</th>
                            <th class="px-4 py-3">3. Kategori</th>
                            <th class="px-4 py-3">4. Kategori</th>
                            <th class="px-4 py-3">5. Kategori Adı</th>
                            <th class="px-4 py-3 text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if(Model != null && Model.Any()) {
                            foreach (var item in Model) {
                                <tr class="border-secondary">
                                    <td class="px-4">@item.Id</td>
                                    <td class="px-4">@item.MainCategory</td>
                                    <td class="px-4">@item.SubCategory</td>
                                    <td class="px-4">@item.SubSubCategory</td>
                                    <td class="px-4">@item.SubSubSubCategory</td>
                                    <td class="px-4 fw-bold">@item.Name</td>
                                    <td class="px-4 text-end">
                                        <a href="/Admin/EditSubSubSubSubCategory/@item.Id" class="btn btn-sm btn-outline-info me-2">Düzenle</a>
                                        <a href="/Admin/DeleteSubSubSubSubCategory/@item.Id" class="btn btn-sm btn-outline-danger" onclick="return confirm('Bu kategoriyi silmek istediğinize emin misiniz?');">Sil</a>
                                    </td>
                                </tr>
                            }
                        } else {
                            <tr><td colspan="7" class="text-center py-4 text-white-50">Henüz 5. seviye kategori eklenmemiş.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#MainCategorySelect').change(function() {
                var main = $(this).val();
                $('#SubCategorySelect option').each(function() {
                    if ($(this).val() === "" || $(this).data('main') === main) { $(this).show(); } else { $(this).hide(); }
                });
            });

            $('#SubCategorySelect').change(function() {
                var sub = $(this).val();
                $('#SubSubCategorySelect option').each(function() {
                    if ($(this).val() === "" || $(this).data('sub') === sub) { $(this).show(); } else { $(this).hide(); }
                });
            });

            $('#SubSubCategorySelect').change(function() {
                var subsub = $(this).val();
                $('#SubSubSubCategorySelect option').each(function() {
                    if ($(this).val() === "" || $(this).data('subsub') === subsub) { $(this).show(); } else { $(this).hide(); }
                });
            });
        });
    </script>
}