@model SunmedMedikal.Models.SubSubCategory
@{
    ViewData["Title"] = "3. Alt Kategori Düzenle";
}

<div class="container mt-5" style="max-width: 600px;">
    <div class="card border-danger shadow-lg">
        <div class="card-header bg-danger text-white p-3">
            <h4 class="mb-0 fw-bold">✏️ 3. Alt Kategori Düzenle: @Model.Name</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="EditSubSubCategory" method="post">
                <input type="hidden" asp-for="Id" />
                
                <div class="mb-3">
                    <label class="form-label fw-bold">Bağlı Olduğu Ana Kategori</label>
                    <select asp-for="MainCategory" id="MainCatSelect" class="form-select" required>
                        @foreach (var main in ViewBag.MainCategories) {
                            <option value="@main.Name">@main.Name</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Bağlı Olduğu Alt Kategori</label>
                    <select asp-for="SubCategory" id="SubCatSelect" class="form-select" required>
                        @foreach (var sub in ViewBag.SubCategories) {
                            <option value="@sub.Name" data-main="@sub.MainCategory">@sub.Name</option>
                        }
                    </select>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">3. Kategori Adı</label>
                    <input asp-for="Name" class="form-control" required />
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a href="/Admin/SubSubCategories" class="btn btn-outline-dark fw-bold px-4">İptal</a>
                    <button type="submit" class="btn btn-success fw-bold px-4">💾 Güncelle</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('MainCatSelect').addEventListener('change', function() {
            var selectedMain = this.value;
            var subOptions = document.getElementById('SubCatSelect').querySelectorAll('option[data-main]');
            subOptions.forEach(opt => {
                opt.style.display = opt.getAttribute('data-main') === selectedMain ? 'block' : 'none';
            });
        });
        document.getElementById('MainCatSelect').dispatchEvent(new Event('change'));
    </script>
}