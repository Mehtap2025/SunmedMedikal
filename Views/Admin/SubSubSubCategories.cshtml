@model IEnumerable<SunmedMedikal.Models.SubSubSubCategory>
@{
    ViewData["Title"] = "4. Alt Kategorileri Yönet";
}

<div class="container-fluid mt-4">
    <div class="card border-dark shadow-sm bg-dark text-white mb-4">
        <div class="card-header border-bottom border-secondary p-3">
            <h5 class="mb-0 fw-bold text-danger">🛠️ Yeni 4. Seviye Alt Kategori Ekle</h5>
        </div>
        <div class="card-body p-4">
            <form asp-action="AddSubSubSubCategory" method="post" class="row align-items-end">
                <div class="col-md-3 mb-3 mb-md-0">
                    <label class="form-label small text-white-50">Ana Kategori</label>
                    <select name="MainCategory" id="MainCategorySelect" class="form-select bg-dark text-white border-secondary" required>
                        <option value="">Seçiniz</option>
                        @foreach (var main in ViewBag.MainCategories) { <option value="@main.Name">@main.Name</option> }
                    </select>
                </div>
                <div class="col-md-3 mb-3 mb-md-0">
                    <label class="form-label small text-white-50">Alt Kategori</label>
                    <select name="SubCategory" id="SubCategorySelect" class="form-select bg-dark text-white border-secondary" required>
                        <option value="">Seçiniz</option>
                        @foreach (var sub in ViewBag.SubCategories) { <option value="@sub.Name" data-main="@sub.MainCategory">@sub.Name</option> }
                    </select>
                </div>
                <div class="col-md-3 mb-3 mb-md-0">
                    <label class="form-label small text-white-50">3. Kategori</label>
                    <select name="SubSubCategory" id="SubSubCategorySelect" class="form-select bg-dark text-white border-secondary" required>
                        <option value="">Seçiniz</option>
                        @foreach (var ss in ViewBag.SubSubCategories) { <option value="@ss.Name" data-sub="@ss.SubCategory">@ss.Name</option> }
                    </select>
                </div>
                <div class="col-md-2 mb-3 mb-md-0">
                    <label class="form-label small text-white-50">Yeni 4. Kategori Adı</label>
                    <input type="text" name="Name" class="form-control bg-dark text-white border-secondary" required />
                </div>
                <div class="col-md-1">
                    <button type="submit" class="btn btn-danger w-100 fw-bold">Ekle</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-dark shadow-sm bg-dark text-white">
        <div class="card-header border-bottom border-secondary p-3">
            <h5 class="mb-0 fw-bold">Mevcut 4. Alt Kategoriler</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0 text-white-50 align-middle">
                    <thead class="table-dark text-white border-bottom border-secondary">
                        <tr>
                            <th class="py-3 px-4">ID</th>
                            <th>Ana Kategori</th>
                            <th>Alt Kategori</th>
                            <th>3. Kategori</th>
                            <th>4. Kategori Adı</th>
                            <th class="text-end px-4">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="px-4">@item.Id</td>
                                <td>@item.MainCategory</td>
                                <td>@item.SubCategory</td>
                                <td>@item.SubSubCategory</td>
                                <td class="fw-bold text-white">@item.Name</td>
                                <td class="text-end px-4">
                                    <form asp-action="DeleteSubSubSubCategory" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Bu 4. kategoriyi silmek istediğinize emin misiniz?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                                    </form>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any()) { <tr><td colspan="6" class="text-center py-4">Henüz kayıtlı kategori bulunmuyor.</td></tr> }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#MainCategorySelect').change(function() {
                var main = $(this).val();
                $('#SubCategorySelect option').hide();
                $('#SubCategorySelect option[value=""]').show();
                $('#SubCategorySelect option[data-main="'+main+'"]').show();
                $('#SubCategorySelect').val('');
                $('#SubSubCategorySelect').val('');
            });
            $('#SubCategorySelect').change(function() {
                var sub = $(this).val();
                $('#SubSubCategorySelect option').hide();
                $('#SubSubCategorySelect option[value=""]').show();
                $('#SubSubCategorySelect option[data-sub="'+sub+'"]').show();
                $('#SubSubCategorySelect').val('');
            });
        });
    </script>
}