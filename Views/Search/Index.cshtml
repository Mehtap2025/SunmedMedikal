@model List<SunmedMedikal.Models.Product>
@{
    ViewData["Title"] = "Detaylı Arama";
}

<div class="container mt-5 mb-5" style="min-height: 50vh;">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            
            <h1 class="display-5 text-danger fw-bold mb-4">Ürün Arama</h1>
            <p class="theme-text-muted mb-4">SUNMED Medikal kataloğunda yer alan ürünler, cihazlar ve markalar arasında arama yapın.</p>

            <form asp-controller="Search" asp-action="Index" method="get" class="d-flex shadow-sm rounded">
                <input type="text" name="query" class="form-control form-control-lg theme-bg-alt theme-text border-secondary" placeholder="Ürün adı veya açıklama yazın..." value="@ViewBag.SearchQuery" required>
                <button type="submit" class="btn btn-danger btn-lg px-4 fw-bold">Ara</button>
            </form>

        </div>
    </div>

    <div class="row mt-5">
        <div class="col-12">
            @if (!string.IsNullOrEmpty(ViewBag.SearchQuery))
            {
                <h4 class="theme-text border-bottom border-danger pb-2 mb-4">
                    "<span class="text-danger">@ViewBag.SearchQuery</span>" için arama sonuçları:
                </h4>
                
                @if (Model.Any())
                {
                    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
                        @foreach (var item in Model)
                        {
                            <div class="col">
                                <div class="card h-100 theme-bg border-secondary shadow-sm">
                                    <div style="background-color: white; padding: 10px; border-radius: 8px 8px 0 0;">
                                        <img src="@item.ImageUrl" class="card-img-top" alt="@item.Name" style="height: 180px; object-fit: contain;">
                                    </div>
                                    <div class="card-body d-flex flex-column">
                                        <h5 class="card-title theme-text fw-bold">@item.Name</h5>
                                        <h6 class="text-danger fw-bold mb-3">@item.Price.ToString("N2") @item.Currency</h6>
                                        
                                        <div class="mt-auto">
                                            <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-danger w-100 fw-bold">Detayları Gör</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-warning text-center p-4 border-0 shadow-sm theme-bg-alt" role="alert">
                        <h5 class="fw-bold mb-1 theme-text">Ürün Bulunamadı</h5>
                        <p class="theme-text-muted mb-0">Aradığınız kriterlere uygun bir ürün stoklarımızda veya kataloğumuzda yer almıyor.</p>
                    </div>
                }
            }
        </div>
    </div>
</div>