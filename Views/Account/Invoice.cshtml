@model SunmedMedikal.Models.Order
@{ Layout = null; }
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body { background: #f4f4f4; color: #000; padding: 20px; }
        .invoice-box { 
            background: #fff; 
            border: 1px solid #ddd; 
            padding: 40px; 
            margin: 0 auto; 
            max-width: 850px; 
            min-height: 1000px;
            position: relative;
        }
        
        /* PDF/YAZDIR BUTONU İÇİN ÖZEL AYAR (Kağıtta görünmez) */
        @@media print {
            .no-print { display: none !important; }
            body { background: #fff; padding: 0; }
            .invoice-box { border: none; margin: 0; padding: 20px; width: 100%; }
        }
        
        .header-logo { color: #dc3545; font-weight: bold; font-size: 32px; text-transform: uppercase; }
        .invoice-title { font-size: 40px; color: #999; font-weight: 200; }
    </style>
</head>
<body>

    <div class="container text-center mb-4 no-print">
        <button onclick="window.print()" class="btn btn-danger btn-lg shadow-sm" style="border-radius: 30px;">
            📄 PDF OLARAK İNDİR / YAZDIR
        </button>
        <p class="text-muted small mt-2">İpucu: Yazdırma ekranında 'Hedef' kısmından 'PDF Olarak Kaydet'i seçebilirsiniz.</p>
    </div>

    <div class="invoice-box shadow">
        <div class="row align-items-center">
            <div class="col-6">
                <div class="header-logo">SUNMED <span class="text-dark">Medikal</span></div>
                <p class="mb-0">Global Laboratuvar Marketi</p>
                <small class="text-muted">www.sunmedmedikal.com</small>
            </div>
            <div class="col-6 text-end">
                <h1 class="invoice-title">FATURA</h1>
                <p class="mb-0"><strong>Fatura No:</strong> #SNM-@Model.Id</p>
                <p><strong>Tarih:</strong> @Model.OrderDate.ToString("dd.MM.yyyy")</p>
            </div>
        </div>

        <hr style="border: 1px solid #000;">

        <div class="row my-5">
            <div class="col-6">
                <h6 class="fw-bold text-danger">SAYIN (MÜŞTERİ):</h6>
                <div class="border-start border-danger border-4 ps-3">
                    <p class="mb-1"><strong>@Model.CustomerName.ToUpper()</strong></p>
                    <p class="mb-1 small">@Model.Address</p>
                    <p class="mb-0 small fw-bold">@Model.District / @Model.City</p>
                    <p class="small">Tel: @Model.Phone</p>
                </div>
            </div>
            <div class="col-6 text-end">
                <h6 class="fw-bold text-danger">GÖNDERİCİ:</h6>
                <p class="mb-1"><strong>SUNMED MEDİKAL LTD. ŞTİ.</strong></p>
                <p class="mb-1 small">İkitelli OSB, Laboratuvar Plaza</p>
                <p class="mb-0 small fw-bold">Esenler / İSTANBUL</p>
                <p class="small">V.D: İkitelli - No: 123456789</p>
            </div>
        </div>

        <table class="table table-bordered border-dark mt-5">
            <thead class="table-dark">
                <tr>
                    <th width="70%">HİZMET / ÜRÜN AÇIKLAMASI</th>
                    <th class="text-end">TUTAR</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td style="padding: 20px; vertical-align: top;">
                        <h6 class="fw-bold text-dark mb-3">Sipariş Edilen Ürünler:</h6>
                        <div style="white-space: pre-line; font-size: 0.95rem; line-height: 1.6;">
                            @Model.OrderNotes
                        </div>
                    </td>
                    <td class="text-end fw-bold fs-5" style="vertical-align: bottom;">
                        @Model.TotalAmount.ToString("N2") TL
                    </td>
                </tr>
            </tbody>
            <tfoot class="table-light">
                <tr>
                    <th class="text-end">ARA TOPLAM (KDV Hariç)</th>
                    <th class="text-end">@((Model.TotalAmount * 0.80m).ToString("N2")) TL</th>
                </tr>
                <tr>
                    <th class="text-end">KDV (%20)</th>
                    <th class="text-end">@((Model.TotalAmount * 0.20m).ToString("N2")) TL</th>
                </tr>
                <tr>
                    <th class="text-end fs-4 text-danger">GENEL TOPLAM</th>
                    <th class="text-end fs-4 text-danger">@Model.TotalAmount.ToString("N2") TL</th>
                </tr>
            </tfoot>
        </table>

        <div class="mt-5 pt-5 border-top small text-muted text-center">
            <p>Bu fatura SUNMED E-Ticaret altyapısı tarafından otomatik oluşturulmuştur.</p>
            <p>İmza / Kaşe Yerine Geçer.</p>
        </div>
    </div>

</body>
</html>