@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<SunmedMedikal.Models.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = SharedLocalizer["Sisteme Giriş"];
}

<style>
    body { background-color: #050505 !important; overflow-x: hidden; }
    
    .carousel-container { position: relative; width: 100%; height: 600px; display: flex; justify-content: center; align-items: center; perspective: 1500px; }
    .carousel-card { position: absolute; width: 360px; background-color: #0a0a0a; border: 1px solid #1a1a1a; border-radius: 12px; transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.6s ease, z-index 0.6s; cursor: pointer; box-shadow: 0 10px 30px rgba(0,0,0,0.8); }
    .carousel-card.active { transform: translateX(0) scale(1) translateZ(0) rotateY(0deg); z-index: 10; opacity: 1; cursor: default; box-shadow: 0 20px 50px rgba(220, 53, 69, 0.15); }
    .carousel-card.left { transform: translateX(-55%) scale(0.85) translateZ(-200px) rotateY(25deg); z-index: 5; opacity: 0.4; }
    .carousel-card.right { transform: translateX(55%) scale(0.85) translateZ(-200px) rotateY(-25deg); z-index: 5; opacity: 0.4; }
    .carousel-card:not(.active) form, .carousel-card:not(.active) a { pointer-events: none; }

    .form-control-custom { background-color: #121212 !important; border: 1px solid #333 !important; color: #fff !important; padding-right: 40px; }
    .form-control-custom:focus { border-color: #dc3545 !important; box-shadow: 0 0 0 0.25rem rgba(220, 53, 69, 0.25) !important; }
    input:-webkit-autofill, input:-webkit-autofill:hover, input:-webkit-autofill:focus, input:-webkit-autofill:active { -webkit-box-shadow: 0 0 0 30px #121212 inset !important; -webkit-text-fill-color: white !important; transition: background-color 5000s ease-in-out 0s; }

    .password-toggle-icon { position: absolute; right: 15px; top: 38px; cursor: pointer; color: #6c757d; transition: color 0.3s ease; }
    .password-toggle-icon:hover { color: #ffffff; }
    .password-toggle-icon.visible { color: #dc3545; }
</style>

<div class="container mt-4 mb-5" style="min-height: 80vh; display: flex; flex-direction: column; justify-content: center;">
    
    <div class="row mb-3 text-center">
        <div class="col-12">
            <h2 class="fw-bold text-uppercase" style="color: #ffffff; letter-spacing: 2px;">
                @SharedLocalizer["SİSTEME"] <span class="text-danger">@SharedLocalizer["GİRİŞ"]</span>
            </h2>
            <p class="text-white-50 fs-6 mt-2">@SharedLocalizer["Giriş yapmak istediğiniz paneli öne getirmek için tıklayın"]</p>
        </div>
    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="row justify-content-center"><div class="col-md-6"><div class="alert alert-danger text-center fw-bold shadow-sm z-index-3 position-relative">@ViewBag.ErrorMessage</div></div></div>
    }

    <div class="carousel-container">
        
        <div id="card-bireysel" class="carousel-card left" style="border-top: 3px solid #6c757d;" onclick="rotateToCenter('bireysel')">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <h4 class="text-white fw-bold">👤 @SharedLocalizer["Bireysel Müşteri"]</h4>
                    <p class="text-white-50 small mt-2">@SharedLocalizer["Kişisel siparişlerinizi ve sepetinizi yönetmek için giriş yapın."]</p>
                    <hr class="border-secondary mt-3 mb-4">
                </div>
                <form asp-controller="Account" asp-action="Login" method="post">
                    <input type="hidden" name="loginType" value="Bireysel" />
                    <div class="mb-3">
                        <label class="form-label text-secondary fw-bold small">@SharedLocalizer["E-posta veya TC Kimlik"]</label>
                        <input type="text" name="username" class="form-control form-control-custom" autocomplete="username" required />
                    </div>
                    <div class="mb-4 position-relative">
                        <label class="form-label text-secondary fw-bold small">@SharedLocalizer["Şifre"]</label>
                        <input type="password" name="password" id="pass-bireysel" class="form-control form-control-custom" autocomplete="current-password" required />
                        <span class="password-toggle-icon" onclick="togglePassword('pass-bireysel', this)"><i class="fas fa-eye"></i></span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-2 mb-3">
                        <div class="form-check">
                            <input class="form-check-input bg-dark border-secondary" type="checkbox" name="rememberMe" value="true" id="remBireysel">
                            <label class="form-check-label text-white-50 small" for="remBireysel" style="cursor: pointer;">@SharedLocalizer["Beni Hatırla"]</label>
                        </div>
                        <a href="/Account/ForgotPassword" class="text-white-50 text-decoration-none small hover-text-danger">@SharedLocalizer["Şifremi Unuttum?"]</a>
                    </div>
                    <button type="submit" class="btn btn-light w-100 fw-bold mb-3" style="border-radius: 30px;">@SharedLocalizer["Giriş Yap"]</button>
                </form>
                <div class="text-center mt-2">
                    <a href="/Account/Register" class="text-white-50 text-decoration-none small">@SharedLocalizer["Hesabınız yok mu?"] <span class="text-white fw-bold">@SharedLocalizer["Kayıt Olun"]</span></a>
                </div>
            </div>
        </div>

        <div id="card-kurumsal" class="carousel-card active" style="border-top: 3px solid #dc3545;" onclick="rotateToCenter('kurumsal')">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <h4 class="text-white fw-bold">🏢 @SharedLocalizer["Kurumsal Müşteri"]</h4>
                    <p class="text-white-50 small mt-2">@SharedLocalizer["Kurumsal tekliflerinizi ve firmanızın siparişlerini yönetin."]</p>
                    <hr class="border-secondary mt-3 mb-4">
                </div>
                <form asp-controller="Account" asp-action="Login" method="post">
                    <input type="hidden" name="loginType" value="Kurumsal" />
                    <div class="mb-3">
                        <label class="form-label text-danger fw-bold small">@SharedLocalizer["E-posta veya Vergi Numarası"]</label>
                        <input type="text" name="username" class="form-control form-control-custom" autocomplete="username" required />
                    </div>
                    <div class="mb-4 position-relative">
                        <label class="form-label text-danger fw-bold small">@SharedLocalizer["Şifre"]</label>
                        <input type="password" name="password" id="pass-kurumsal" class="form-control form-control-custom" autocomplete="current-password" required />
                        <span class="password-toggle-icon" onclick="togglePassword('pass-kurumsal', this)"><i class="fas fa-eye"></i></span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-2 mb-3">
                        <div class="form-check">
                            <input class="form-check-input bg-dark border-danger" type="checkbox" name="rememberMe" value="true" id="remKurumsal">
                            <label class="form-check-label text-white-50 small" for="remKurumsal" style="cursor: pointer;">@SharedLocalizer["Beni Hatırla"]</label>
                        </div>
                        <a href="/Account/ForgotPassword" class="text-danger text-decoration-none small fw-bold">@SharedLocalizer["Şifremi Unuttum?"]</a>
                    </div>
                    <button type="submit" class="btn btn-danger w-100 fw-bold mb-3" style="border-radius: 30px;">@SharedLocalizer["Giriş Yap"]</button>
                </form>
                <div class="text-center mt-2">
                    <a href="/Account/Register" class="text-white-50 text-decoration-none small">@SharedLocalizer["Hesabınız yok mu?"] <span class="text-white fw-bold">@SharedLocalizer["Kayıt Olun"]</span></a>
                </div>
            </div>
        </div>

        <div id="card-admin" class="carousel-card right" style="border-top: 3px solid #8b0000; background-color: #080303;" onclick="rotateToCenter('admin')">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <h4 class="text-danger fw-bold">⚙️ @SharedLocalizer["Yönetici Paneli"]</h4>
                    <p class="text-white-50 small mt-2">@SharedLocalizer["Sadece SUNMED Medikal yetkilileri içindir."]</p>
                    <hr class="border-danger opacity-25 mt-3 mb-4">
                </div>
                <form asp-controller="Account" asp-action="Login" method="post">
                    <input type="hidden" name="loginType" value="Admin" />
                    <div class="mb-3">
                        <label class="form-label text-white fw-bold small">@SharedLocalizer["Yönetici ID"]</label>
                        <input type="text" name="username" class="form-control form-control-custom" autocomplete="username" required />
                    </div>
                    <div class="mb-4 position-relative">
                        <label class="form-label text-white fw-bold small">@SharedLocalizer["Güvenlik Şifresi"]</label>
                        <input type="password" name="password" id="pass-admin" class="form-control form-control-custom" autocomplete="current-password" required />
                        <span class="password-toggle-icon" onclick="togglePassword('pass-admin', this)"><i class="fas fa-eye"></i></span>
                    </div>
                    <button type="submit" class="btn w-100 fw-bold mb-3 text-white shadow" style="background-color: #b02a37; border-radius: 30px;">@SharedLocalizer["Yetkili Girişi Yap"]</button>
                </form>
                <div class="text-center mt-3"><span class="text-danger small fw-bold"><i class="fas fa-lock"></i> 🔒 Güvenli Bağlantı</span></div>
            </div>
        </div>

    </div>
</div>

<script>
    function togglePassword(inputId, iconElement) {
        const input = document.getElementById(inputId);
        const icon = iconElement.querySelector('i');
        if (input.type === 'password') { input.type = 'text'; icon.className = 'fas fa-eye-slash'; iconElement.classList.add('visible'); } 
        else { input.type = 'password'; icon.className = 'fas fa-eye'; iconElement.classList.remove('visible'); }
    }

    const cardsList = ['kurumsal', 'admin', 'bireysel']; 
    let currentIndex = 0; let autoRotateTimer;
    let isHovering = false; // Formun aktif olup olmadığını anlar

    function rotateToCenter(target) {
        const bireysel = document.getElementById('card-bireysel');
        const kurumsal = document.getElementById('card-kurumsal');
        const admin = document.getElementById('card-admin');

        bireysel.className = 'carousel-card'; 
        kurumsal.className = 'carousel-card'; 
        admin.className = 'carousel-card'; 

        if (target === 'kurumsal') {
            kurumsal.classList.add('active'); bireysel.classList.add('left'); admin.classList.add('right'); currentIndex = 0;
        } else if (target === 'admin') {
            admin.classList.add('active'); kurumsal.classList.add('left'); bireysel.classList.add('right'); currentIndex = 1;
        } else if (target === 'bireysel') {
            bireysel.classList.add('active'); admin.classList.add('left'); kurumsal.classList.add('right'); currentIndex = 2;
        }
    }
    
    function startAutoRotate() {
        if (isHovering) return; // Fare üstündeyse asla başlatma
        clearInterval(autoRotateTimer);
        autoRotateTimer = setInterval(() => {
            if (!isHovering) {
                currentIndex++; if (currentIndex >= cardsList.length) currentIndex = 0; 
                rotateToCenter(cardsList[currentIndex]);
            }
        }, 3000); // Süreyi biraz uzattım, rahat okunsun
    }

    function stopAutoRotate() { 
        isHovering = true; 
        clearInterval(autoRotateTimer); 
    }

    document.addEventListener('DOMContentLoaded', () => {
        const container = document.querySelector('.carousel-container');
        const allCards = document.querySelectorAll('.carousel-card');

        container.addEventListener('mouseenter', stopAutoRotate);
        container.addEventListener('mouseleave', () => { isHovering = false; startAutoRotate(); });

        // Tıklanırsa veya klavyeyle girilirse dönüşü KESİNLİKLE durdur
        allCards.forEach(card => {
            card.addEventListener('focusin', stopAutoRotate);
            card.addEventListener('click', stopAutoRotate);
        });

        startAutoRotate();
    });
</script>