@{
    ViewData["Title"] = "Şifremi Unuttum";
}

<style>
    body { background-color: #050505 !important; }
    .custom-input {
        background-color: #1a1a1a !important;
        border: 1px solid #333 !important;
        color: #fff !important;
    }
    .custom-input:focus {
        border-color: #dc3545 !important;
        box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25) !important;
    }
</style>

<div class="container mt-5 mb-5" style="min-height: 70vh; display: flex; align-items: center;">
    <div class="row justify-content-center w-100">
        <div class="col-md-5">
            
            <div class="card shadow-lg" style="background-color: #0a0a0a; border: 1px solid #222; border-top: 4px solid #dc3545; border-radius: 12px;">
                <div class="card-header bg-transparent border-0 pt-4 pb-0 text-center">
                    <h3 class="fw-bold text-white text-uppercase" style="letter-spacing: 1px;">ŞİFREMİ <span class="text-danger">UNUTTUM</span></h3>
                    <p class="text-white-50 small">Kayıtlı E-Posta adresinizi veya Kullanıcı Adınızı girin</p>
                </div>

                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="alert alert-danger mx-4 mt-3 text-center fw-bold shadow-sm">
                        @ViewBag.ErrorMessage
                    </div>
                }
                @if (ViewBag.SuccessMessage != null)
                {
                    <div class="alert alert-success mx-4 mt-3 text-center fw-bold shadow-sm">
                        @ViewBag.SuccessMessage <br><br>
                        <a asp-action="Login" class="btn btn-sm btn-success fw-bold">Giriş Yap</a>
                    </div>
                }

                <div class="card-body p-4 p-md-5 pt-3">
                    
                    <form asp-controller="Account" asp-action="ForgotPassword" method="post">
                        
                        <div class="mb-4">
                            <label class="form-label fw-bold text-white">E-Posta veya Kullanıcı Adı</label>
                            <input type="text" name="emailOrUsername" class="form-control form-control-lg custom-input" placeholder="ornek@mail.com" required />
                        </div>
                        
                        <button type="submit" class="btn btn-danger btn-lg w-100 fw-bold shadow-sm mb-4" style="border-radius: 30px;">
                            ✉️ Yeni Şifre Gönder
                        </button>
                        
                        <div class="text-center">
                            <a asp-action="Login" class="text-white-50 text-decoration-none small">
                                Hatırladınız mı? <span class="text-white fw-bold">Giriş Yapın</span>
                            </a>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>