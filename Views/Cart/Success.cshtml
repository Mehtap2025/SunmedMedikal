@{
    ViewData["Title"] = "Sipariş Onayı ve Fatura";
    var orderId = TempData["OrderId"] ?? "Belirsiz";
    var orderTotal = TempData["OrderTotal"] ?? "0,00";
    var paymentMethod = TempData["OrderPayment"] ?? "Havale / Kredi Kartı";
}

<style>
    body { background-color: #050505 !important; }
    
    .invoice-card {
        background-color: #111;
        border: 1px solid #222;
        border-top: 5px solid #dc3545;
        border-radius: 8px;
        padding: 40px;
        max-width: 700px;
        margin: 0 auto;
        box-shadow: 0 15px 35px rgba(0,0,0,0.8);
    }

    .invoice-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 2px dashed #333;
        padding-bottom: 20px;
        margin-bottom: 30px;
    }

    .invoice-header img {
        height: 50px; /* Sitedeki logonun yüksekliği */
    }

    .invoice-details {
        background-color: #0a0a0a;
        border: 1px solid #1a1a1a;
        border-radius: 8px;
        padding: 20px;
        margin-bottom: 30px;
    }
    
    .invoice-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 10px;
        color: #bbb;
    }
    .invoice-row strong { color: #fff; }
</style>

<div class="container mt-5 mb-5" style="min-height: 70vh;">
    
    <div class="text-center mb-5">
        <div class="display-1 text-success mb-3">✅</div>
        <h2 class="text-white fw-bold" style="letter-spacing: 1px;">SİPARİŞİNİZ <span class="text-danger">BAŞARIYLA ALINDI!</span></h2>
        <p class="text-white-50 mt-2">Bizi tercih ettiğiniz için teşekkür ederiz. Sipariş detaylarınız aşağıdadır.</p>
    </div>

    <div class="invoice-card">
        
        <div class="invoice-header">
            <div>
                <img src="/images/logo.png" alt="SUNMED Medikal Logo" onerror="this.src='/img/logo.png'; this.onerror=null;">
            </div>
            <div class="text-end">
                <h5 class="text-white fw-bold mb-0">SİPARİŞ ONAYI</h5>
                <small class="text-white-50">Tarih: @DateTime.Now.ToString("dd.MM.yyyy HH:mm")</small>
            </div>
        </div>

        <div class="invoice-details">
            <div class="invoice-row">
                <span>Sipariş Numarası:</span>
                <strong class="text-danger fs-5">#@orderId</strong>
            </div>
            <div class="invoice-row">
                <span>Ödeme Yöntemi:</span>
                <strong>@paymentMethod</strong>
            </div>
            <div class="invoice-row">
                <span>Durum:</span>
                <strong class="text-success">Onay Bekliyor</strong>
            </div>
            <hr class="border-secondary my-3">
            <div class="invoice-row mb-0">
                <span class="fs-5">Ödenen Toplam Tutar:</span>
                <strong class="text-success fs-4">@orderTotal TL</strong>
            </div>
        </div>

        @if (paymentMethod.ToString().Contains("Havale"))
        {
            <div class="alert alert-warning bg-dark border-warning text-warning small text-center mb-4">
                <i class="fas fa-info-circle"></i> Havale/EFT işleminizi gerçekleştirirken açıklama kısmına <strong>#@orderId</strong> sipariş numaranızı yazmayı lütfen unutmayınız.
            </div>
        }

        <div class="text-center">
            <p class="text-white-50 small mb-4">Faturanız ürünlerinizle birlikte veya E-Fatura olarak kayıtlı e-posta adresinize gönderilecektir.</p>
            <a href="/" class="btn btn-outline-light px-5 py-2" style="border-radius: 30px;">🏠 Alışverişe Devam Et</a>
        </div>

    </div>
</div>