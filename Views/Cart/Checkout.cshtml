            let citySelect = $('#CitySelect');
            let districtSelect = $('#DistrictSelect');
            let cityManual = $('#CityManual');
            let districtManual = $('#DistrictManual');

            citySelect.empty().append('<option value="">Şehir Seçiniz...</option>');
            $.each(allTurkeyData, function(city, districts) {
                citySelect.append($('<option></option>').val(city).html(city));
            });
            citySelect.append('<option value="Diğer" class="text-warning fw-bold">➕ Diğer (Manuel Gir)</option>');

            citySelect.change(function() {
                let selectedCity = $(this).val();
                districtSelect.empty().append('<option value="">İlçe Seçiniz...</option>');

                if (selectedCity === 'Diğer') {
                    cityManual.slideDown(200).prop('required', true);
                    districtSelect.slideUp(200).prop('required', false);
                    districtManual.slideDown(200).prop('required', true);
                } else {
                    cityManual.slideUp(200).prop('required', false);
                    districtSelect.slideDown(200).prop('required', true);
                    districtManual.slideUp(200).prop('required', false);

                    if(selectedCity && allTurkeyData[selectedCity]) {
                        $.each(allTurkeyData[selectedCity], function(i, district) {
                            districtSelect.append($('<option></option>').val(district).html(district));
                        });
                        districtSelect.append('<option value="Diğer" class="text-warning fw-bold">➕ Diğer (Manuel Gir)</option>');
                    }
                }
            });

            districtSelect.change(function() {
                if ($(this).val() === 'Diğer') {
                    districtManual.slideDown(200).prop('required', true);
                } else {
                    districtManual.slideUp(200).prop('required', false);
                }
            });

            let savedCity = '@Html.Raw(ViewBag.CurrentUser?.City ?? "")';
            let savedDistrict = '@Html.Raw(ViewBag.CurrentUser?.District ?? "")';
            
            if (savedCity) {
                if ($("#CitySelect option[value='" + savedCity + "']").length > 0) {
                    citySelect.val(savedCity).trigger('change');
                    
                    if (savedDistrict) {
                        setTimeout(() => {
                            if ($("#DistrictSelect option[value='" + savedDistrict + "']").length > 0) {
                                districtSelect.val(savedDistrict);
                            }
                        }, 100);
                    }
                }
            }

        });
    </script>
