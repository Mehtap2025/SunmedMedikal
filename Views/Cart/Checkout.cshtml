@{
    ViewData["Title"] = "Güvenli Ödeme ve Onay";
}

<style>
    body { background-color: #050505 !important; }
    
    .checkout-card {
        background-color: #0a0a0a;
        border: 1px solid #1a1a1a;
        border-radius: 12px;
        padding: 30px;
    }
    
    .form-control-custom, .form-select-custom {
        background-color: #121212 !important;
        border: 1px solid #333 !important;
        color: #fff !important;
    }
    
    .form-control-custom:focus, .form-select-custom:focus {
        border-color: #dc3545 !important;
        box-shadow: 0 0 0 0.25rem rgba(220, 53, 69, 0.25) !important;
    }

    .payment-box {
        background-color: #161616;
        border: 1px solid #333;
        border-radius: 8px;
        padding: 20px;
        display: none; 
        margin-bottom: 20px;
    }
</style>

<div class="container mt-5 mb-5" style="min-height: 75vh;">
    
    <div class="row mb-5">
        <div class="col-12">
            <h2 class="fw-bold text-uppercase" style="color: #ffffff; letter-spacing: 2px;">
                GÜVENLİ <span class="text-danger">ÖDEME VE ONAY</span>
            </h2>
            <p class="text-white-50">Siparişinizi veya kurumsal teklif talebinizi tamamlamak için lütfen bilgilerinizi girin.</p>
        </div>
    </div>

    <div class="row g-5">
        
        <div class="col-lg-8">
            <div class="checkout-card shadow-lg" style="border-top: 3px solid #dc3545;">
                <h4 class="text-white fw-bold mb-4">Teslimat & Fatura Bilgileri</h4>
                
                @if (TempData["CartWarning"] != null)
                {
                    <div class="alert alert-danger fw-bold shadow-sm rounded mb-4">
                        ⚠️ @TempData["CartWarning"]
                    </div>
                }
                
                <form id="checkoutForm" asp-controller="Cart" asp-action="PlaceOrder" method="post" enctype="multipart/form-data">
    
                    <h5 class="text-white fw-bold mb-3 border-bottom border-secondary pb-2">1. Teslimat Bilgileri</h5>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-white-50 small">Adınız Soyadınız / Firma Ünvanı <span class="text-danger">*</span></label>
                            <input type="text" name="FullName" class="form-control form-control-custom" value="@ViewBag.CurrentUser?.FullName" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-white-50 small">İrtibat Numarası <span class="text-danger">*</span></label>
                            <input type="text" name="Phone" class="form-control form-control-custom" value="@ViewBag.CurrentUser?.PhoneNumber" required />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-white-50 small">İl / Şehir <span class="text-danger">*</span></label>
                            <select id="CitySelect" name="City" class="form-select form-select-custom mb-2" required>
                                <option value="">Şehir Seçiniz...</option>
                            </select>
                            <input type="text" id="CityManual" name="CityManual" class="form-control form-control-custom" placeholder="Lütfen İl Yazınız..." style="display: none;" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-white-50 small">İlçe <span class="text-danger">*</span></label>
                            <select id="DistrictSelect" name="District" class="form-select form-select-custom mb-2" required>
                                <option value="">Önce Şehir Seçiniz</option>
                            </select>
                            <input type="text" id="DistrictManual" name="DistrictManual" class="form-control form-control-custom" placeholder="Lütfen İlçe Yazınız..." style="display: none;" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-white-50 small">Açık Teslimat Adresi <span class="text-danger">*</span></label>
                        <textarea name="Address" class="form-control form-control-custom" rows="3" placeholder="Mahalle, Cadde, Sokak, Bina No..." required>@ViewBag.CurrentUser?.Address</textarea>
                    </div>

                    <h5 class="text-white fw-bold mb-3 mt-4 border-bottom border-secondary pb-2">2. Fatura Bilgileri</h5>
    
                    @if(ViewBag.CurrentUser?.CustomerType == "Kurumsal")
                    {
                        <div class="alert bg-dark border-secondary text-white-50 mb-3 small">
                            <i class="fw-bold text-danger">Kurumsal Müşteri:</i> Faturanız sistemdeki vergi bilgilerinize kesilecektir.
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label text-white-50 small">Vergi Dairesi</label>
                                <input type="text" name="TaxOffice" class="form-control form-control-custom" value="@ViewBag.CurrentUser?.TaxOffice" readonly />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label text-white-50 small">Vergi Numarası</label>
                                <input type="text" name="TaxNumber" class="form-control form-control-custom" value="@ViewBag.CurrentUser?.TaxNumber" readonly />
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label text-white-50 small">TC Kimlik Numarası (E-Fatura Zorunluluğu)</label>
                            <input type="text" name="TcNo" class="form-control form-control-custom" value="@ViewBag.CurrentUser?.TcNo" placeholder="11 Haneli TC Kimlik Numaranız" maxlength="11" />
                        </div>
                    }

                    <h5 class="text-white fw-bold mb-3 mt-4 border-bottom border-secondary pb-2">3. Ödeme Yöntemi</h5>
                    <div class="d-flex gap-4 mb-3">
                        <div class="form-check custom-radio">
                            <input class="form-check-input payment-radio" type="radio" name="PaymentMethod" id="havale" value="Havale/EFT" checked>
                            <label class="form-check-label text-white fw-bold" for="havale" style="cursor:pointer;">
                                🏦 Havale / EFT
                            </label>
                        </div>
                        <div class="form-check custom-radio">
                            <input class="form-check-input payment-radio" type="radio" name="PaymentMethod" id="krediKarti" value="Kredi Kartı">
                            <label class="form-check-label text-white fw-bold" for="krediKarti" style="cursor:pointer;">
                                💳 Kredi Kartı
                            </label>
                        </div>
                    </div>

                    <div id="havale-box" class="payment-box" style="display: block;">
                        <h6 class="text-white mb-3 border-bottom border-secondary pb-2">Banka Hesap Bilgilerimiz</h6>
                        <p class="text-white-50 small mb-3">Alıcı: <strong class="text-white">SUNMED Medikal ve Global Laboratuvar San. Tic. Ltd. Şti.</strong></p>
    
                        <div class="row g-3">
                            <div class="col-12 border-bottom border-secondary pb-2 mb-2">
                                <span class="text-danger fw-bold small d-block">TÜRKİYE İŞ BANKASI</span>
                                <code class="text-warning fw-bold fs-6" style="background: transparent;">TR22 0006 4000 0011 0701 1124 12</code>
                            </div>
                            <div class="col-12 border-bottom border-secondary pb-2 mb-2">
                                <span class="text-danger fw-bold small d-block">GARANTİ BANKASI</span>
                                <code class="text-warning fw-bold fs-6" style="background: transparent;">TR49 0006 2001 1200 0006 2919 64</code>
                            </div>
                            <div class="col-12 border-bottom border-secondary pb-2 mb-2">
                                <span class="text-danger fw-bold small d-block">Halkbank</span>
                                <code class="text-warning fw-bold fs-6" style="background: transparent;">TR81 0001 2009 8590 0010 2615 13</code>
                            </div>
                            <div class="col-12">
                                <span class="text-danger fw-bold small d-block">KUVEYTTÜRK</span>
                                <code class="text-warning fw-bold fs-6" style="background: transparent;">TR86 0020 5000 0999 1386 0000 01</code>
                            </div>
                        </div>
                        
                        <div class="mt-4 p-3 bg-dark border border-warning rounded">
                            <label class="form-label text-warning fw-bold small">Ödeme Dekontu Yükle (Zorunlu)</label>
                            <input type="file" id="ReceiptFile" name="ReceiptFile" class="form-control form-control-custom border-warning text-white" accept="image/*,.pdf" />
                            <p class="text-white-50 small mt-2 mb-0">Ödemeyi gerçekleştirdikten sonra pdf veya resim formatında dekontunuzu ekleyiniz.</p>
                        </div>
                    </div>
                
                    <div id="kk-box" class="payment-box">
                        <h6 class="text-white mb-3">Kredi Kartı Bilgileri</h6>
                        <input type="text" id="ccName" class="form-control form-control-custom mb-3" placeholder="Kart Üzerindeki İsim">
                        <input type="text" id="ccNumber" class="form-control form-control-custom mb-3" placeholder="Kart Numarası (0000 0000 0000 0000)" maxlength="19">
                        <div class="d-flex gap-3">
                            <input type="text" id="ccDate" class="form-control form-control-custom" placeholder="Ay/Yıl (MM/YY)" style="width: 50%;" maxlength="5">
                            <input type="password" id="ccCvv" class="form-control form-control-custom" placeholder="CVV" style="width: 50%;" maxlength="3">
                        </div>
                        <p class="text-white-50 small mt-3 mb-0"><i class="fas fa-lock"></i> Kart bilgileriniz 256-bit SSL ile güvenle şifrelenir.</p>
                    </div>

                    <div class="mb-4 mt-2">
                        <label class="form-label text-white-50 small">Sipariş Notu (Opsiyonel)</label>
                        <textarea name="OrderNotes" class="form-control form-control-custom" rows="2" placeholder="Örn: Kapıya bırakınız..."></textarea>
                    </div>

                    <button type="submit" class="btn btn-danger btn-lg w-100 fw-bold shadow-sm" style="border-radius: 30px;">💳 GÜVENLİ ÖDEME YAP</button>

                </form>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="checkout-card shadow-lg position-sticky" style="top: 20px; border-top: 3px solid #6c757d;">
                <h5 class="text-white fw-bold mb-4">Sipariş Özeti</h5>
    
            <div class="alert bg-dark text-white-50 small p-2 border-secondary mb-3">
                <i class="fas fa-sync-alt"></i> Canlı Kur: 1$=@ViewBag.UsdKur.ToString("N2") TL / 1€=@ViewBag.EurKur.ToString("N2") TL
            </div>
    
            <div class="d-flex justify-content-between mb-3 text-white-50">
                <span>Ürünler Toplamı</span>
                <span class="text-white">@ViewBag.AraToplam.ToString("N2") TL</span>
            </div>
                
                <div class="d-flex justify-content-between mb-3 text-white-50">
                    <span>Kargo / Teslimat</span>
                    
                    @if (ViewBag.KargoUcreti == 0)
                    {
                        <span class="text-success fw-bold">Ücretsiz</span>
                    }
                    else
                    {
                        <span class="text-white">@ViewBag.KargoUcreti.ToString("N2") TL</span>
                    }
                </div>
                
                <hr class="border-secondary my-3">
                
                <div class="d-flex justify-content-between mb-4">
                    <span class="text-white fw-bold fs-5">Genel Toplam</span>
                    <span class="text-success fw-bold fs-5">@ViewBag.GenelToplam.ToString("N2") TL</span>
                </div>

                <div class="alert alert-warning text-dark small mb-0" style="background-color: #ffc107; border: none; border-radius: 8px;">
                    <div class="fw-bold mb-1">🎁 Kampanya:</div>
                    2000 TL ve üzeri alışverişlerinizde kargo ücretsizdir!
                </div>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            
            // --- 1. ÖDEME YÖNTEMİ AKORDİYON JS KODU ---
            $('.payment-radio').change(function() {
                if ($(this).val() === 'Havale/EFT') {
                    $('#kk-box').slideUp(300, function() { 
                        $('#havale-box').slideDown(300); 
                    });
                } else {
                    $('#havale-box').slideUp(300, function() { 
                        $('#kk-box').slideDown(300); 
                    });
                }
            });

            // --- YENİ EKLENEN KISIM: ZORUNLU ALAN KONTROLLERİ ---
            $('#checkoutForm').submit(function(e) {
                let selectedPayment = $('input[name="PaymentMethod"]:checked').val();
                
                // Kredi Kartı Kontrolü
                if (selectedPayment === 'Kredi Kartı') {
                    let ccName = $('#ccName').val().trim();
                    let ccNumber = $('#ccNumber').val().trim();
                    let ccDate = $('#ccDate').val().trim();
                    let ccCvv = $('#ccCvv').val().trim();

                    if (!ccName || !ccNumber || !ccDate || !ccCvv) {
                        e.preventDefault(); 
                        alert('⚠️ Lütfen Kredi Kartı bilgilerinizi eksiksiz doldurunuz!');
                        return false;
                    }
                    if (ccNumber.length < 15) {
                        e.preventDefault();
                        alert('⚠️ Lütfen geçerli bir Kart Numarası giriniz!');
                        return false;
                    }
                }
                
                // Havale Kontrolü (Dekont Zorunlu)
                if (selectedPayment === 'Havale/EFT') {
                    let receiptInput = $('#ReceiptFile').val();
                    if (!receiptInput) {
                        e.preventDefault(); 
                        alert('⚠️ Havale/EFT işlemlerinde dekont yüklemek zorunludur!');
                        return false;
                    }
                }
            });

