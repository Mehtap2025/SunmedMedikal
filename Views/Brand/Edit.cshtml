@model SunmedMedikal.Models.Brand
@{
    ViewData["Title"] = "Marka Düzenle";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            
            <div class="card shadow-lg" style="background-color: #0a0a0a; border: 1px solid #1a1a1a; border-top: 4px solid #dc3545; border-radius: 12px;">
                <div class="card-header bg-transparent border-0 pt-4 pb-0 text-center">
                    <h3 class="fw-bold text-white text-uppercase" style="letter-spacing: 1px;">MARKAYI <span class="text-danger">DÜZENLE</span></h3>
                    
                    <div class="mt-4 mb-2 p-3 bg-white d-inline-block rounded shadow-sm">
                        <img src="@Model.ImageUrl" alt="@Model.Name" style="max-height: 60px; object-fit: contain;">
                    </div>
                </div>
                
                <div class="card-body p-5">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        
                        <div class="mb-4">
                            <label asp-for="Name" class="form-label fw-bold text-danger">Marka Adı</label>
                            <input asp-for="Name" class="form-control form-control-lg bg-dark text-white border-secondary" required />
                        </div>

                        <div class="mb-5">
                            <label asp-for="ImageUrl" class="form-label fw-bold text-danger">Logo Dosya Yolu</label>
                            <input asp-for="ImageUrl" class="form-control form-control-lg bg-dark text-white border-secondary" />
                            <small class="text-muted mt-2 d-block">Mevcut yolu değiştirerek farklı bir logo atayabilirsiniz.</small>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="Index" class="btn btn-outline-light btn-lg px-4 me-md-2" style="border-radius: 30px;">İptal</a>
                            <button type="submit" class="btn btn-danger btn-lg px-5 fw-bold shadow-sm" style="border-radius: 30px;">Güncelle</button>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>